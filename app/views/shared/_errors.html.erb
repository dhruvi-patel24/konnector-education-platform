<% if object.errors.any? %>
  <div class="error-summary">
    <h3><%= pluralize(object.errors.count, "error") %> prohibited this <%= object.class.name.underscore.humanize.downcase %> from being saved:</h3>
    <ul>
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
