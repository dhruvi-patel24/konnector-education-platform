<div style="max-width: 400px; margin: 4rem auto;">
  <div class="card">
    <h2 style="margin-top: 0; margin-bottom: 1.5rem; text-align: center;">Sign up</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password %>
        <% if @minimum_password_length %>
        <em style="font-size: 0.75rem; color: var(--text-light);">(<%= @minimum_password_length %> characters minimum)</em>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :role %>
        <%= f.select :role, User.roles.keys.map { |r| [r.titleize, r] }, {}, { required: true } %>
      </div>

      <div class="form-group">
        <%= f.label :school_id, "School (Optional for Admin)" %>
        <%= f.collection_select :school_id, School.all, :id, :name, { include_blank: "None" } %>
      </div>

      <div style="margin-top: 2rem;">
        <%= f.submit "Sign up", class: "btn btn-primary", style: "width: 100%;" %>
      </div>
    <% end %>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem;">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
