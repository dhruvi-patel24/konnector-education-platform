<!DOCTYPE html>
<html>
  <head>
    <title>Konnector Education Platform</title>
  </head>

  <body>
    <nav>
      <div>Konnector Education Platform</div>
      <div>
        <% if user_signed_in? %>
          <% if current_user.admin? %>
            <%= "Role: #{current_user.role}" %><br>

            <%= link_to "Schools", admin_schools_path %>
            <%= link_to "Add School Admin", new_admin_school_admin_path %>
          <% elsif current_user.school_admin? %>
            <%= "Role: #{current_user.role}" %><br>

            <%= link_to "Courses", school_admin_courses_path %>
            <%= link_to "Batches", school_admin_batches_path %>
            <%= link_to "Enrollments", school_admin_enrollments_path %>
            <%= link_to "My School", edit_school_admin_school_path(current_user.school) %>
          <% elsif current_user.student? %>
            <%= "Role: #{current_user.role}" %><br>

            <%= link_to "My Batches", student_batches_path %>
            <%= link_to "Request Enrollment", student_enrollments_path %>
          <% end %>
          <%= button_to "Logout", destroy_user_session_path, method: :delete %>
        <% else %>
          <%= link_to "Login", root_path %>
          <%= link_to "Sign Up", new_user_registration_path %>
        <% end %>
      </div>
    </nav>

  </body>
</html>
