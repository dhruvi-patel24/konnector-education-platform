<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <h1>Schools</h1>
  <%= link_to "Add New School", new_admin_school_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Address</th>
        <th>Admins</th>
        <th>Show</th>
        <th>Edit</th>
        <th>Delete</th>
      </tr>
    </thead>
    <tbody>
      <% @schools.each do |school| %>
        <tr>
          <td><%= school.name %></td>
          <td><%= school.address %></td>
          <td><%= school.users.school_admin.pluck(:email) %></td>
          <td><%= link_to 'Show', admin_school_path(school) %></td>
          <td><%= link_to 'Edit', edit_admin_school_path(school) %></td>
          <td><%= link_to 'Delete', admin_school_path(school), data: 
            { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
