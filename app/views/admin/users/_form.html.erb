<h1><%= @user.new_record? ? "Add New #{ @user.role.titleize }" : "Edit #{ @user.role.titleize }" %></h1>

<div class="card" style="max-width: 600px;">
  <%= form_with(model: [:admin, @user], local: true) do |f| %>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, required: true %>
    </div>

    <% if @user.new_record? %>
      <div class="form-group">
        <%= f.label :password %>
        <%= f.password_field :password, required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, required: true %>
      </div>
    <% end %>

    <% if current_user.school_admin? %>
      <%= f.hidden_field :role, value: 'student' %>
      <%= f.hidden_field :school_id, value: current_user.school_id %>
    <% else %>
      <div class="form-group">
        <%= f.label :role %>
        <%= f.select :role, User.roles.keys.map { |r| [r.titleize, r] }, {}, { required: true } %>
      </div>

      <div class="form-group">
        <%= f.label :school_id, "School (Optional for Admin)" %>
        <%= f.collection_select :school_id, School.all, :id, :name, { include_blank: "None" } %>
      </div>
    <% end %>

    <div style="margin-top: 2rem;">
      <%= f.submit @user.new_record? ? "Create #{ @user.role.titleize }" : "Update #{ @user.role.titleize }", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_users_path(role: @user.role), class: "btn", style: "color: var(--text-light);" %>
    </div>
  <% end %>
</div>
